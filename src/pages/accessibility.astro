---
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout title="Accessibility | Virtue Media Visions Network" description="Accessibility statement for the Virtue Media Visions Network website." canonical="https://www.vmvnetwork.com/accessibility">
  <article class="mx-auto max-w-[980px] px-page py-section">
    <p class="eyebrow text-gold">Policy / Accessibility</p>
    <h1 class="editorial-display mt-6 text-[clamp(3.7rem,8vw,7.8rem)]">Accessibility.</h1>
    <div class="mt-14 max-w-[760px] space-y-7 text-[1.05rem] leading-[1.8] text-ink/65">
      <p>Virtue Media Visions Network intends this website to be usable across devices and by people using keyboard navigation and assistive technology.</p>
      <p>The site uses semantic landmarks, a skip link, visible focus treatment, restrained motion, responsive layouts, and text links for navigation.</p>
      <p>If you encounter a barrier while using the site, contact VMV by telephone at +1 (888) 933-5878, Ext. 101 so the issue can be documented and addressed.</p>
      <a class="rule-link text-gold" href="/">Return home <span aria-hidden="true">→</span></a>
    </div>
  </article>
</BaseLayout>
