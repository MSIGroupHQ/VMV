---
import BaseLayout from '../layouts/BaseLayout.astro'
const services = [
  { number:'01', label:'Connectivity', title:'Build the network.', body:'Terrestrial, fiber-optic, wireless, and network connectivity services designed to support dependable digital operations.', items:['Fiber-optic network solutions','Broadband and wireless connectivity','Network design and performance planning'] },
  { number:'02', label:'Cybersecurity', title:'Protect the system.', body:'Cybersecurity services focused on protecting digital infrastructure from unauthorized access, cyber threats, and data breaches, with incident response and recovery support.', items:['Threat detection and prevention','Infrastructure security','Incident response and recovery'] },
  { number:'03', label:'Digital forensics', title:'Prove what happened.', body:'Digital forensic services supporting the examination of systems and digital evidence to trace breaches, identify malicious activity, recover critical information, and assist investigations.', items:['Digital evidence examination','Breach and incident analysis','Investigative support and recovery'] }
]
const executives = [
  ['Yarnike Washington','Chairman of the Board & Founder'],
  ['Amit Srivastava','Co-Founder & Board Member'],
  ['Shailesh Jain','Chief Technology Officer'],
  ['Shweta Singh','Chief Information Officer']
]
const operatingTeam = [
  ['Jennifer Jones-ElHag','Director of Communications'],['Tiffany Childs','Director Human Resource'],['Deleep George','Manager Network Design'],['Sandeep Katore','Manager System Engineer'],['Arsh T','Software Developer'],['Kiran Tarlekar','Manager Software Developer'],['Jerlene Treherne','Manager Digital Marketer']
]
---
<BaseLayout
  title="Virtue Media Visions Network | Telecommunications, Cybersecurity & Digital Forensics"
  description="Virtue Media Visions Network LLC provides broadband and fiber-optic connectivity, cybersecurity services, and digital forensics support from New York and Bhubaneswar."
>
  <section class="hero-stage">
    <div class="mx-auto max-w-[1480px] hero-shell">
      <div class="hero-copy">
        <div>
          <p class="eyebrow text-gold-bright">Telecommunications · Cybersecurity · Digital Forensics</p>
          <h1 class="editorial-display hero-headline"><span>Build the network.</span><span>Protect the system.</span><span class="gold-word">Prove what happened.</span></h1>
        </div>
        <div class="hero-lower">
          <p class="hero-deck">Virtue Media Visions Network LLC combines broadband and fiber infrastructure, cybersecurity, and digital forensics across operating locations in New York and Bhubaneswar.</p>
          <div class="flex flex-wrap gap-x-7 gap-y-5">
            <a class="rule-link text-gold-bright" href="tel:+18889335878">Talk to VMV <span aria-hidden="true">↗</span></a>
            <a class="rule-link text-white/65" href="#capabilities">View capabilities <span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </div>
      <aside class="hero-aside">
        <div class="flex items-start justify-between gap-6">
          <div>
            <p class="eyebrow text-white/40">Network identity</p>
            <p class="mt-3 max-w-[220px] text-sm leading-relaxed text-white/60">Information, communications, technology, security, and digital evidence.</p>
          </div>
          <img src="/icons/vmv-icon.png" width="210" height="210" alt="Virtue Media Visions monogram" />
        </div>
        <div class="hero-signal">
          <p class="eyebrow text-gold-bright">Operating corridor</p>
          <div class="signal-line"></div>
          <div class="signal-meta"><span>New York</span><span>Bhubaneswar</span></div>
        </div>
      </aside>
    </div>
    <div class="hero-strip">
      <div><span>01</span><strong>Broadband + Fiber</strong></div>
      <div><span>02</span><strong>Cybersecurity</strong></div>
      <div><span>03</span><strong>Digital Forensics</strong></div>
    </div>
  </section>

  <section id="company" class="border-b border-line bg-paper">
    <div class="section-wrap thesis-grid">
      <p class="eyebrow pt-2 text-smoke">01 / Company</p>
      <h2 class="editorial-display thesis-title">Connectivity is the beginning. Protection and accountability complete the job.</h2>
      <div class="thesis-copy lg:pt-2">
        <p>Virtue Media Visions Network LLC is a telecommunications and information and communications technology company focused on broadband connectivity, cybersecurity, and digital forensics.</p>
        <p>Its work spans terrestrial and fiber-optic networks, wireless connectivity, infrastructure security, incident response, and digital evidence examination.</p>
        <div class="gold-rule mt-10"></div>
      </div>
    </div>
  </section>

  <section id="capabilities" class="cap-stage">
    <div class="section-wrap">
      <div class="cap-head">
        <p class="eyebrow pt-2 text-white/40">02 / Capabilities</p>
        <h2 class="editorial-display">One company. Three connected disciplines.</h2>
      </div>
      {services.map((service) => (
        <article class="cap-row">
          <div><div class="cap-num">{service.number}</div><p class="eyebrow mt-3 text-white/38">{service.label}</p></div>
          <div><h3>{service.title}</h3><p class="mt-5">{service.body}</p></div>
          <ul>{service.items.map((item) => <li>{item}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>

  <section id="presence" class="presence-stage border-b border-line">
    <div class="section-wrap presence-grid">
      <p class="eyebrow pt-2 text-smoke">03 / Presence</p>
      <div class="presence-head">
        <h2 class="editorial-display">New York ↔ Bhubaneswar.</h2>
        <p class="presence-note">VMV maintains operating addresses in New York City and Bhubaneswar, Odisha, connecting its telecommunications and ICT presence across two distinct markets.</p>
        <div class="corridor" aria-label="Operating locations: New York and Bhubaneswar">
          <div class="corridor-city"><strong>New York</strong><span>30 Wall St · New York, NY</span></div>
          <div class="corridor-track"><span class="corridor-pulse"></span></div>
          <div class="corridor-city text-left md:text-right"><strong>Bhubaneswar</strong><span>Saheed Nagar · Odisha</span></div>
        </div>
      </div>
    </div>
  </section>

  <section id="leadership" class="bg-paper border-b border-line">
    <div class="section-wrap">
      <div class="leadership-head">
        <p class="eyebrow pt-2 text-smoke">04 / Leadership</p>
        <div><h2 class="editorial-display">The people behind the network.</h2><p class="mt-7 max-w-[760px] text-lg leading-relaxed text-ink/58">VMV’s board and operating team spans technology, communications, network design, software, human resources, and marketing.</p></div>
      </div>
      <div class="executive-grid">
        {executives.map((person) => <div class="executive"><span class="role">{person[1]}</span><strong>{person[0]}</strong></div>)}
      </div>
      <div class="team-rail">
        {operatingTeam.map((person,index) => <div class="team-row"><span class="index">{String(index + 5).padStart(2,'0')}</span><strong>{person[0]}</strong><span class="role">{person[1]}</span></div>)}
      </div>
    </div>
  </section>

  <section id="contact" class="contact-stage">
    <div class="section-wrap contact-grid">
      <div>
        <p class="eyebrow text-gold-bright">05 / Contact</p>
        <h2 class="editorial-display">Bring us the network problem.</h2>
        <div class="mt-12 flex flex-wrap gap-x-8 gap-y-5">
          <a class="rule-link text-gold-bright" href="tel:+18889335878">Call +1 (888) 933-5878 · Ext. 101 <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <address class="contact-addresses not-italic">
        <div class="contact-address"><p class="eyebrow text-white/36">United States</p><strong>30 Wall St · 8th Floor #1050</strong><span>New York, NY 10005</span></div>
        <div class="contact-address"><p class="eyebrow text-white/36">India</p><strong>401, BMC Bhawani Mall St</strong><span>Saheed Nagar · Bhubaneswar · Odisha 751007</span></div>
      </address>
    </div>
  </section>
</BaseLayout>
