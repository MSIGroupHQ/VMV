---
import BaseLayout from '../layouts/BaseLayout.astro'

const team = [
  ['Yarnike Washington', 'Chairman of the Board & Founder'],
  ['Amit Srivastava', 'Co-Founder & Board Member'],
  ['Shailesh Jain', 'Chief Technology Officer'],
  ['Jennifer Jones-ElHag', 'Director of Communications'],
  ['Tiffany Childs', 'Director Human Resource'],
  ['Deleep George', 'Manager Network Design'],
  ['Sandeep Katore', 'Manager System Engineer'],
  ['Shweta Singh', 'Chief Information Officer'],
  ['Arsh T', 'Software Developer'],
  ['Kiran Tarlekar', 'Manager Software Developer'],
  ['Jerlene Treherne', 'Manager Digital Marketer']
]
---
<BaseLayout
  title="Virtue Media Visions Network LLC | Telecommunications & ICT"
  description="Virtue Media Visions Network LLC specializes in broadband connectivity, cybersecurity, and digital forensics."
>
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="kicker">Telecommunications & ICT</p>
        <h1>Virtue Media Visions Network LLC</h1>
        <p class="tagline">Building new communities to empower endless possibilities!</p>
        <div class="hero-actions">
          <a class="primary-link" href="#services">Explore Services</a>
          <a class="secondary-link" href="tel:+18889335878">Call VMV</a>
        </div>
      </div>
      <div class="hero-mark">
        <img src="/icons/vmv-icon.png" width="360" height="360" alt="Virtue Media Visions Network monogram" />
      </div>
    </div>
  </section>

  <section id="about" class="section section-light">
    <div class="section-grid">
      <div class="section-label">About Us</div>
      <div class="section-content prose-large">
        <p>Virtue Media Visions Network LLC is a leading Telecommunications and ICT (Information and Communications Technology) company, specializing in Broadband connectivity, Cybersecurity, and Digital Forensics.</p>
        <p>We deliver high-performance services through terrestrial and Fiber-Optic networks, ensuring fast, reliable access for our customers. In addition to our core offerings, we implement cutting-edge Cybersecurity solutions to protect against digital threats and provide expert Digital Forensics services for secure, thorough investigations of cyber incidents.</p>
        <p>VMV is dedicated to advancing digital communication, safeguarding data, and delivering seamless media experiences to our users.</p>
      </div>
    </div>
  </section>

  <section id="services" class="section section-dark">
    <div class="section-grid">
      <div class="section-label">Our Services</div>
      <div class="service-list">
        <article class="service-row">
          <h2>Fiber Optics Solution</h2>
          <p>Virtue Media Vision's Network LLC will revolutionize your online experience with advanced connectivity solutions tailored for the modern digital age. We go beyond basic browsing — providing enterprise-grade connectivity, wireless solutions, and robust network services that ensure unparalleled speed, reliability, and performance optimization. Whether for business or personal use, our ISP-driven solutions deliver high-speed, secure, and seamless internet access. Benefit from improved search engine visibility, faster loading times, and cutting-edge wireless technology. Elevate your connection to the next level and experience the future of digital connectivity with Virtue Media Vision's Network LLC.</p>
        </article>
        <article class="service-row">
          <h2>Cybersecurity</h2>
          <p>At Virtue Media Vision's Network LLC, we provide comprehensive cybersecurity solutions designed to safeguard the digital infrastructure. Our advanced security measures protect against cyber threats, data breaches, and unauthorized access, ensuring the integrity of your systems and information. From proactive threat detection and prevention to incident response and recovery, our cybersecurity services offer robust, end-to-end protection. Trust us to keep your business secure, compliant, and resilient in today’s evolving digital landscape.</p>
        </article>
        <article class="service-row">
          <h2>Digital Forensics</h2>
          <p>We offer advanced digital forensic services to investigate and resolve cyber incidents swiftly and effectively. Our forensic experts meticulously analyze digital evidence to trace breaches, uncover malicious activity, and support legal investigations. Whether you're dealing with data theft, cyberattacks, or internal misconduct, our comprehensive solutions ensure a thorough and secure examination of your systems. Rely on our digital forensics expertise to help you recover critical information, restore business operations, and protect your organization from future threats.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="availability">
    <div>
      <p class="kicker">Service Availability</p>
      <h2>Check the ability to connect our services in your area.</h2>
    </div>
    <a class="primary-link dark" href="#contact">Get in Touch</a>
  </section>

  <section id="team" class="section section-light">
    <div class="section-grid">
      <div class="section-label">Meet The Team</div>
      <div class="team-list">
        {team.map((person) => (
          <div class="team-row">
            <strong>{person[0]}</strong>
            <span>{person[1]}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="section contact-section">
    <div class="section-grid">
      <div class="section-label">Get in Touch</div>
      <div class="contact-grid">
        <div>
          <h2>Virtue Media Visions Network LLC</h2>
          <p class="company-type">An Information, Communications and Technology Company.</p>
          <a class="phone-link" href="tel:+18889335878">1 (888) 933-5878 <span>Ext. 101</span></a>
        </div>
        <address>
          <div>
            <strong>New York</strong>
            <span>30 Wall St</span>
            <span>8th Floor #1050</span>
            <span>New York, NY 10005</span>
          </div>
          <div>
            <strong>Bhubaneswar</strong>
            <span>401, BMC Bhawani Mall St</span>
            <span>Saheed Nagar, Bhubaneswar</span>
            <span>Odisha 751007</span>
          </div>
        </address>
      </div>
    </div>
  </section>
</BaseLayout>
