---
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout title="Privacy | Virtue Media Visions Network" description="Privacy information for the Virtue Media Visions Network website." canonical="https://www.vmvnetwork.com/privacy">
  <article class="mx-auto max-w-[980px] px-page py-section">
    <p class="eyebrow text-gold">Policy / Privacy</p>
    <h1 class="editorial-display mt-6 text-[clamp(3.7rem,8vw,7.8rem)]">Privacy.</h1>
    <div class="mt-14 max-w-[760px] space-y-7 text-[1.05rem] leading-[1.8] text-ink/65">
      <p>This website provides public information about Virtue Media Visions Network LLC and its services. This release does not install advertising trackers or behavioral analytics.</p>
      <p>If you contact VMV by telephone or another communication channel, information you provide may be used to respond to your inquiry and coordinate requested services.</p>
      <p>This notice should be reviewed if analytics, forms, cookies, payment tools, or third-party embeds are added.</p>
      <a class="rule-link text-gold" href="/">Return home <span aria-hidden="true">→</span></a>
    </div>
  </article>
</BaseLayout>
